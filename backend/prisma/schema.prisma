generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  ADMIN
  EDITOR
}

enum ContentSection {
  GALLERY
  STORE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SaleMethod {
  FREE
  CONTACT
}

enum MediaType {
  IMAGE
  VIDEO
}

model Admin {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  email        String         @unique
  passwordHash String         @map("password_hash")
  role         AdminRole      @default(ADMIN)
  isActive     Boolean        @default(true) @map("is_active")
  lastLoginAt  DateTime?      @map("last_login_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  sessions     AdminSession[]

  @@map("admins")
}

model AdminSession {
  id            String    @id @default(uuid()) @db.Uuid
  adminId       String    @db.Uuid @map("admin_id")
  tokenHash     String    @unique @map("token_hash")
  csrfTokenHash String    @map("csrf_token_hash")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  expiresAt     DateTime  @map("expires_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  admin         Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model Game {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  slug        String     @unique
  description String?
  coverImage  String?    @map("cover_image")
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  categories  Category[]
  contents    Content[]

  @@map("games")
}

model Category {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  slug      String
  section   ContentSection
  gameId    String?        @db.Uuid @map("game_id")
  parentId  String?        @db.Uuid @map("parent_id")
  sortOrder Int            @default(0) @map("sort_order")
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  game      Game?          @relation(fields: [gameId], references: [id], onDelete: SetNull)
  parent    Category?      @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[]     @relation("CategoryChildren")
  contents  Content[]

  @@unique([section, slug])
  @@index([gameId])
  @@index([parentId])
  @@map("categories")
}

model Content {
  id               String         @id @default(uuid()) @db.Uuid
  title            String
  slug             String         @unique
  section          ContentSection
  status           ContentStatus  @default(DRAFT)
  saleMethod       SaleMethod     @default(FREE) @map("sale_method")
  gameId           String?        @db.Uuid @map("game_id")
  categoryId       String?        @db.Uuid @map("category_id")
  producer         String         @default("Zecution Gaming")
  shortDescription String?        @map("short_description")
  description      String?
  price            Decimal?       @db.Decimal(10, 2)
  priceLabel       String?        @map("price_label")
  downloadUrl      String?        @map("download_url")
  isFeatured       Boolean        @default(false) @map("is_featured")
  viewCount        Int            @default(0) @map("view_count")
  downloadCount    Int            @default(0) @map("download_count")
  sortOrder        Int            @default(0) @map("sort_order")
  publishedAt      DateTime?      @map("published_at")
  deletedAt        DateTime?      @map("deleted_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  game             Game?          @relation(fields: [gameId], references: [id], onDelete: SetNull)
  category         Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media            ContentMedia[]
  features         ContentFeature[]
  reactions        ContentReaction[]
  reviews          ContentReview[]

  @@index([section, status, deletedAt])
  @@index([gameId])
  @@index([categoryId])
  @@map("contents")
}

model ContentMedia {
  id            String    @id @default(uuid()) @db.Uuid
  contentId     String    @db.Uuid @map("content_id")
  mediaType     MediaType @default(IMAGE) @map("media_type")
  filePath      String    @map("file_path")
  thumbnailPath String?   @map("thumbnail_path")
  altText       String?   @map("alt_text")
  isCover       Boolean   @default(false) @map("is_cover")
  sortOrder     Int       @default(0) @map("sort_order")
  width         Int?
  height        Int?
  createdAt     DateTime  @default(now()) @map("created_at")
  content       Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, sortOrder])
  @@map("content_media")
}

model ContentFeature {
  id        String   @id @default(uuid()) @db.Uuid
  contentId String   @db.Uuid @map("content_id")
  label     String
  value     String
  sortOrder Int      @default(0) @map("sort_order")
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, sortOrder])
  @@map("content_features")
}

model ContentReaction {
  id        String   @id @default(uuid()) @db.Uuid
  contentId String   @db.Uuid @map("content_id")
  emoji     String   @db.VarChar(16)
  clientIp  String   @map("client_ip") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, emoji, clientIp])
  @@index([contentId])
  @@map("content_reactions")
}

model User {
  id                    String          @id @default(uuid()) @db.Uuid
  username              String          @unique @db.VarChar(50)
  email                 String          @unique @db.VarChar(255)
  passwordHash          String          @map("password_hash")
  avatarUrl             String?         @map("avatar_url")
  isActive              Boolean         @default(true) @map("is_active")
  isEmailVerified       Boolean         @default(false) @map("is_email_verified")
  verificationCode      String?         @map("verification_code") @db.VarChar(10)
  verificationExpiresAt DateTime?       @map("verification_expires_at")
  role                  String          @default("USER") @db.VarChar(20)
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  sessions              UserSession[]
  reviews               ContentReview[]
  modSubmissions        ModSubmission[]

  @@map("users")
}

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model ContentReview {
  id         String   @id @default(uuid()) @db.Uuid
  contentId  String   @db.Uuid @map("content_id")
  userId     String?  @db.Uuid @map("user_id")
  authorName String   @map("author_name") @db.VarChar(100)
  rating     Int      @default(5)
  comment    String   @db.Text
  clientIp   String?  @map("client_ip") @db.VarChar(64)
  isApproved Boolean  @default(true) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([contentId, createdAt])
  @@index([userId])
  @@map("content_reviews")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

enum QuoteStatus {
  NEW
  REVIEWING
  QUOTED
  ACCEPTED
  REJECTED
  COMPLETED
}

enum QuoteType {
  VEHICLE
  MAP
  MODIFICATION
  MODEL
  OTHER
}

model QuoteRequest {
  photos        QuotePhoto[]
  id            String      @id @default(uuid()) @db.Uuid
  submissionId  String      @unique @db.Uuid @map("submission_id")
  name          String      @db.VarChar(120)
  email         String      @db.VarChar(254)
  game          String      @db.VarChar(120)
  type          QuoteType
  description   String      @db.VarChar(10000)
  referenceUrl  String?     @map("reference_url") @db.VarChar(2000)
  budget        String?     @db.VarChar(120)
  desiredDate   String?     @map("desired_date") @db.VarChar(10)
  status        QuoteStatus @default(NEW)
  adminNotes    String      @default("") @map("admin_notes") @db.VarChar(10000)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("quote_requests")
}

model QuotePhoto {
  id        String       @id @default(uuid()) @db.Uuid
  quoteId   String       @db.Uuid @map("quote_id")
  name      String       @db.VarChar(200)
  data      Bytes
  sortOrder Int          @map("sort_order")
  quote     QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_photos")
}

enum ModSubmissionStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

model ModSubmission {
  id              String               @id @default(uuid()) @db.Uuid
  submissionId    String               @unique @map("submission_id") @db.Uuid
  userId          String?              @db.Uuid @map("user_id")
  producerName    String               @map("producer_name") @db.VarChar(120)
  email           String               @db.VarChar(254)
  discord         String?              @db.VarChar(100)
  title           String               @db.VarChar(150)
  game            String               @db.VarChar(120)
  category        String               @default("Araç") @db.VarChar(80)
  version         String?              @db.VarChar(50)
  description     String               @db.VarChar(10000)
  downloadUrl     String               @map("download_url") @db.VarChar(2000)
  trailerUrl      String?              @map("trailer_url") @db.VarChar(2000)
  saleType        String               @default("FREE") @map("sale_type") @db.VarChar(30)
  suggestedPrice  String?              @map("suggested_price") @db.VarChar(100)
  hasPermission   Boolean              @default(true) @map("has_permission")
  status          ModSubmissionStatus  @default(PENDING)
  adminNotes      String               @default("") @map("admin_notes") @db.VarChar(10000)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  photos          ModSubmissionPhoto[]
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([userId])
  @@map("mod_submissions")
}

model ModSubmissionPhoto {
  id           String        @id @default(uuid()) @db.Uuid
  submissionId String        @db.Uuid @map("submission_id")
  name         String        @db.VarChar(200)
  data         Bytes
  sortOrder    Int           @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at")
  submission   ModSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("mod_submission_photos")
}
