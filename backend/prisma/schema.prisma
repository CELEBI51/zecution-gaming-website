generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  ADMIN
  EDITOR
}

enum ContentSection {
  GALLERY
  STORE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SaleMethod {
  FREE
  CONTACT
}

enum MediaType {
  IMAGE
  VIDEO
}

model Admin {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  email        String         @unique
  passwordHash String         @map("password_hash")
  role         AdminRole      @default(ADMIN)
  isActive     Boolean        @default(true) @map("is_active")
  lastLoginAt  DateTime?      @map("last_login_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  sessions     AdminSession[]

  @@map("admins")
}

model AdminSession {
  id            String    @id @default(uuid()) @db.Uuid
  adminId       String    @db.Uuid @map("admin_id")
  tokenHash     String    @unique @map("token_hash")
  csrfTokenHash String    @map("csrf_token_hash")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  expiresAt     DateTime  @map("expires_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  admin         Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model Game {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  slug        String     @unique
  description String?
  coverImage  String?    @map("cover_image")
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  categories  Category[]
  contents    Content[]

  @@map("games")
}

model Category {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  slug      String
  section   ContentSection
  gameId    String?        @db.Uuid @map("game_id")
  parentId  String?        @db.Uuid @map("parent_id")
  sortOrder Int            @default(0) @map("sort_order")
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  game      Game?          @relation(fields: [gameId], references: [id], onDelete: SetNull)
  parent    Category?      @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[]     @relation("CategoryChildren")
  contents  Content[]

  @@unique([section, slug])
  @@index([gameId])
  @@index([parentId])
  @@map("categories")
}

model Content {
  id               String         @id @default(uuid()) @db.Uuid
  title            String
  slug             String         @unique
  section          ContentSection
  status           ContentStatus  @default(DRAFT)
  saleMethod       SaleMethod     @default(FREE) @map("sale_method")
  gameId           String?        @db.Uuid @map("game_id")
  categoryId       String?        @db.Uuid @map("category_id")
  producer         String         @default("Zecution Gaming")
  shortDescription String?        @map("short_description")
  description      String?
  price            Decimal?       @db.Decimal(10, 2)
  priceLabel       String?        @map("price_label")
  downloadUrl      String?        @map("download_url")
  isFeatured       Boolean        @default(false) @map("is_featured")
  sortOrder        Int            @default(0) @map("sort_order")
  publishedAt      DateTime?      @map("published_at")
  deletedAt        DateTime?      @map("deleted_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  game             Game?          @relation(fields: [gameId], references: [id], onDelete: SetNull)
  category         Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media            ContentMedia[]
  features         ContentFeature[]

  @@index([section, status, deletedAt])
  @@index([gameId])
  @@index([categoryId])
  @@map("contents")
}

model ContentMedia {
  id            String    @id @default(uuid()) @db.Uuid
  contentId     String    @db.Uuid @map("content_id")
  mediaType     MediaType @default(IMAGE) @map("media_type")
  filePath      String    @map("file_path")
  thumbnailPath String?   @map("thumbnail_path")
  altText       String?   @map("alt_text")
  isCover       Boolean   @default(false) @map("is_cover")
  sortOrder     Int       @default(0) @map("sort_order")
  width         Int?
  height        Int?
  createdAt     DateTime  @default(now()) @map("created_at")
  content       Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, sortOrder])
  @@map("content_media")
}

model ContentFeature {
  id        String   @id @default(uuid()) @db.Uuid
  contentId String   @db.Uuid @map("content_id")
  label     String
  value     String
  sortOrder Int      @default(0) @map("sort_order")
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, sortOrder])
  @@map("content_features")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
